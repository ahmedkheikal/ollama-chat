{
    "target": {
        "url": "https://github.com/ahmedkheikal",
        "description": "Open Ahmed Kheikal's GitHub profile to capture visible headings."
    },
    "flows": [
        {
            "name": "collect_profile_heading",
            "description": "Navigate to the profile and capture the main header text.",
            "steps": [
                {
                    "type": "navigate",
                    "url": "https://github.com/ahmedkheikal"
                },
                {
                    "type": "wait",
                    "selector": {
                        "selector": "body",
                        "strategy": "css",
                        "timeout": 5000
                    }
                },
                {
                    "type": "wait",
                    "duration": 1000
                }
            ],
            "extractions": [
                {
                    "name": "profile_header",
                    "description": "Extract the text content of the primary profile heading.",
                    "selector": {
                        "selector": "h1",
                        "strategy": "css",
                        "timeout": 5000
                    },
                    "extractType": "text"
                }
            ]
        }
    ]
}
